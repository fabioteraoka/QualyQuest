{
  "entities": {
    "Organization": {
      "title": "Organization (Tenant)",
      "description": "Multi-tenant organization boundary isolating SGQ data, manuals, and records",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Organization unique identifier"
        },
        "name": {
          "type": "string",
          "description": "Organization business name"
        },
        "legalName": {
          "type": "string",
          "description": "Organization official legal/commercial name"
        },
        "logoUrl": {
          "type": "string",
          "description": "URL or vector path of the organization logo"
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "INACTIVE"],
          "description": "Organization operating status"
        },
        "configuration": {
          "type": "object",
          "description": "Tenant specific configurations including sectors, categories, SLAs, and presentation defaults"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "name", "status", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile with role-based access control metadata and organization tenancy",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User full name or alias"
        },
        "role": {
          "type": "string",
          "enum": ["ADMIN", "GESTOR_SGQ", "AUDITOR", "CONSULTA"],
          "description": "User SGQ role"
        },
        "organizationId": {
          "type": "string",
          "description": "ID of the tenant organization"
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "INACTIVE"],
          "description": "Account operational status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["uid", "email", "role", "organizationId", "status", "createdAt", "updatedAt"]
    },
    "NonConformity": {
      "title": "Non-Conformity Record (RNC)",
      "description": "Complete aviation quality management non-conformity report (F 001-29 standard)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique NC record ID"
        },
        "codigoFormulario": {
          "type": "string",
          "description": "Official form code (e.g. F 001-29)"
        },
        "revisao": {
          "type": "string",
          "description": "Form revision code"
        },
        "numeroNC": {
          "type": "string",
          "description": "Human-readable sequential or assigned NC number"
        },
        "titulo": {
          "type": "string",
          "description": "Title and summary of the non-conformity"
        },
        "tipoAcao": {
          "type": "string",
          "enum": ["Corretiva", "Preventiva", "Oportunidade de Melhoria"],
          "description": "Classification of required action"
        },
        "descricaoNC": {
          "type": "string",
          "description": "Detailed description of the non-conformity"
        },
        "normaReferencia": {
          "type": "string",
          "description": "Reference norm and clause"
        },
        "setor": {
          "type": "string",
          "description": "Department or base involved"
        },
        "categoria": {
          "type": "string",
          "description": "SGQ taxonomy category"
        },
        "statusGeral": {
          "type": "string",
          "description": "Lifecycle status of the non-conformity"
        },
        "prazoResposta": {
          "type": "string",
          "description": "Target response deadline"
        },
        "dataIdentificacao": {
          "type": "string",
          "description": "Identification date"
        },
        "auditor": {
          "type": "string",
          "description": "Auditor responsible for raising the RNC"
        },
        "criadoEm": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "atualizadoEm": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "codigoFormulario", "numeroNC", "titulo", "tipoAcao", "descricaoNC", "statusGeral", "criadoEm", "atualizadoEm"]
    },
    "Manual": {
