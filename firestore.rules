rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // ----------------------------------------------------
    // Hardened Global Helpers
    // ----------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : (isSignedIn() && request.auth.token.email == 'fteraoka@gmail.com' ? 'ADMIN' : 'CONSULTA');
    }

    function getUserOrgId() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId
        : '';
    }

    function isSuperPlatformAdmin() {
      return isSignedIn() && ('email' in request.auth.token) && request.auth.token.email.lower() == 'fteraoka@gmail.com';
    }

    function isSystemAdmin() {
      return isSignedIn() && (
        isSuperPlatformAdmin() ||
        getUserRole() == 'ADMIN' ||
        getUserRole() == 'ADMINISTRADOR'
      );
    }

    function isGestorSGQ() {
      return isSignedIn() && (
        isSystemAdmin() ||
        getUserRole() == 'GESTOR_SGQ' ||
        getUserRole() == 'GESTOR'
      );
    }

    function isAuditor() {
      return isSignedIn() && (
        isGestorSGQ() ||
        getUserRole() == 'AUDITOR'
      );
    }

    function isUserActive() {
      return isSignedIn() && (
        isSuperPlatformAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (!('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) || 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'INACTIVE' &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'INATIVO' &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'BLOQUEADO')) &&
         (!('ativo' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ativo != false))
      );
    }

    function userBelongsToOrg(orgId) {
      return isSignedIn() && (
        isSuperPlatformAdmin() ||
        (isUserActive() && getUserOrgId() != '' && orgId != '' && (
          getUserOrgId() == orgId ||
          (getUserOrgId() == 'org-impacto-aviation' && orgId == 'org_impacto_aviation') ||
          (getUserOrgId() == 'org_impacto_aviation' && orgId == 'org-impacto-aviation')
        ))
      );
    }

    // ----------------------------------------------------
    // User Profile Rules (users/{userId})
    // Prevents self-privilege escalation and arbitrary tenant hopping
    // ----------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId || 
        isSuperPlatformAdmin() || 
        isGestorSGQ()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        isSuperPlatformAdmin() || 
        (isGestorSGQ() && isUserActive()) ||
        request.auth.uid == userId
      );
      allow delete: if (isSuperPlatformAdmin() || (isSystemAdmin() && isUserActive() && getUserOrgId() == resource.data.organizationId)) && isValidId(userId);
    }

    // ----------------------------------------------------
    // User Invitations Collection (userInvitations/{invitationId})
    // Bridging multi-user linking to organizations safely
    // ----------------------------------------------------
    match /userInvitations/{invitationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        isSuperPlatformAdmin() ||
        (userBelongsToOrg(request.resource.data.organizationId) && isGestorSGQ())
      ) && isValidId(invitationId);
      allow update: if isSignedIn() && (
        isSuperPlatformAdmin() ||
        (userBelongsToOrg(resource.data.organizationId) && isGestorSGQ()) ||
        (resource.data.status == 'PENDENTE' && request.resource.data.status == 'ACEITO')
      );
      allow delete: if isSignedIn() && (
        isSuperPlatformAdmin() ||
        (userBelongsToOrg(resource.data.organizationId) && (isGestorSGQ() || isSystemAdmin()))
      ) && isValidId(invitationId);
    }

    // ----------------------------------------------------
    // Organizations Collection (organizations/{organizationId})
    // ----------------------------------------------------
    match /organizations/{organizationId} {
      allow get: if isSignedIn();
      allow list: if isSuperPlatformAdmin() || (isGestorSGQ() && isUserActive());
      allow create: if isSignedIn() && isUserActive() && (
        isSuperPlatformAdmin() || 
        (organizationId != 'org_impacto_aviation' && request.resource.data.createdByUserUid == request.auth.uid)
      );
      allow update: if isSuperPlatformAdmin() || (userBelongsToOrg(organizationId) && (isGestorSGQ() || getUserRole() == 'ADMIN'));
      allow delete: if isSuperPlatformAdmin() && isValidId(organizationId);

      // ----------------------------------------------------
      // Non-Conformities Subcollection (organizations/{orgId}/nonConformities/{ncId})
      // ----------------------------------------------------
      match /nonConformities/{ncId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(ncId) &&
                                 (!('organizationId' in request.resource.data) || request.resource.data.organizationId == organizationId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(ncId);
      }

      // ----------------------------------------------------
      // Manuals Subcollection (organizations/{orgId}/manuals/{manualId})
      // ----------------------------------------------------
      match /manuals/{manualId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update, delete: if userBelongsToOrg(organizationId) &&
                                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(manualId);
      }

      // ----------------------------------------------------
      // Audit Trails Subcollection (organizations/{orgId}/auditTrails/{auditId})
      // Strictly Write-Once / Append-Only / Immutable
      // ----------------------------------------------------
      match /auditTrails/{auditId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create: if isSignedIn() && isValidId(organizationId) && isValidId(auditId) &&
                         !exists(/databases/$(database)/documents/organizations/$(organizationId)/auditTrails/$(auditId)) &&
                         (userBelongsToOrg(organizationId) || 
                          (request.resource.data.entity == 'USER' && request.resource.data.changedByUid == request.auth.uid));
        allow update, delete: if false; // STRICT IMMUTABILITY: Cannot update or delete any audit log
      }

      // ----------------------------------------------------
      // RNC Comparisons Subcollection (organizations/{orgId}/rncComparisons/{comparisonId})
      // ----------------------------------------------------
      match /rncComparisons/{comparisonId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(comparisonId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(comparisonId);
      }

      // ----------------------------------------------------
      // Validated Knowledge Base (organizations/{orgId}/validatedKnowledge/{knowledgeId})
      // Segregation of Duties: N5 promotion cannot be self-approved by the same author
      // ----------------------------------------------------
      match /validatedKnowledge/{knowledgeId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create: if userBelongsToOrg(organizationId) &&
                         getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(knowledgeId) &&
                         // N5 can only be created directly if approved by Gestor or Admin
                         (request.resource.data.nivelMaturidade != 5 || isGestorSGQ());
        allow update: if userBelongsToOrg(organizationId) &&
                         getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(knowledgeId) &&
                         (
                           (request.resource.data.nivelMaturidade != 5 && request.resource.data.status != 'PADRAO_SGQ') ||
                           (isGestorSGQ() && (!('criadoPorUid' in resource.data) || resource.data.criadoPorUid != request.auth.uid))
                         );
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(knowledgeId);
      }

      // ----------------------------------------------------
      // External Audits Subcollection (organizations/{orgId}/externalAudits/{auditId})
      // ----------------------------------------------------
      match /externalAudits/{auditId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(auditId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(auditId);
      }

      // ----------------------------------------------------
      // Audit Findings Subcollection (organizations/{orgId}/auditFindings/{findingId})
      // ----------------------------------------------------
      match /auditFindings/{findingId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(findingId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(findingId);
      }

      // ----------------------------------------------------
      // Audit Lessons Learned Subcollection (organizations/{orgId}/auditLessonsLearned/{lessonId})
      // ----------------------------------------------------
      match /auditLessonsLearned/{lessonId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(lessonId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(lessonId);
      }

      // ----------------------------------------------------
      // FASE 9: Pessoas & Colaboradores (organizations/{orgId}/persons/{personId})
      // ----------------------------------------------------
      match /persons/{personId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(personId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(personId);
      }

      // ----------------------------------------------------
      // FASE 9: Competências (organizations/{orgId}/competencies/{competencyId})
      // ----------------------------------------------------
      match /competencies/{competencyId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(competencyId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(competencyId);
      }

      // ----------------------------------------------------
      // FASE 9: Vínculos de Competências (organizations/{orgId}/personCompetencies/{personCompetencyId})
      // ----------------------------------------------------
      match /personCompetencies/{personCompetencyId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(personCompetencyId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(personCompetencyId);
      }

      // ----------------------------------------------------
      // FASE 9: Cursos de Treinamento (organizations/{orgId}/trainingCourses/{courseId})
      // ----------------------------------------------------
      match /trainingCourses/{courseId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(courseId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(courseId);
      }

      // ----------------------------------------------------
      // FASE 9: Registros de Treinamentos (organizations/{orgId}/trainingRecords/{trainingRecordId})
      // ----------------------------------------------------
      match /trainingRecords/{trainingRecordId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(trainingRecordId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(trainingRecordId);
      }

      // ----------------------------------------------------
      // FASE 9: Qualificações e Habilitações (organizations/{orgId}/qualifications/{qualificationId})
      // ----------------------------------------------------
      match /qualifications/{qualificationId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(qualificationId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(qualificationId);
      }

      // ----------------------------------------------------
      // FASE 9: Documentos & Evidências de Pessoas (organizations/{orgId}/personDocuments/{documentId})
      // ----------------------------------------------------
      match /personDocuments/{documentId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(documentId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(documentId);
      }

      // ----------------------------------------------------
      // FASE 9: Requisitos de Atividades (organizations/{orgId}/activityRequirements/{activityId})
      // ----------------------------------------------------
      match /activityRequirements/{activityId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(activityId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(activityId);
      }

      // ----------------------------------------------------
      // FASE 9: Sugestões de IA para Competências (organizations/{orgId}/aiCompetencySuggestions/{suggestionId})
      // ----------------------------------------------------
      match /aiCompetencySuggestions/{suggestionId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(suggestionId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(suggestionId);
      }

      // ----------------------------------------------------
      // FASE 10: Documentos Controlados (organizations/{orgId}/controlled_documents/{documentId})
      // ----------------------------------------------------
      match /controlled_documents/{documentId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(documentId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(documentId);
      }

      // ----------------------------------------------------
      // FASE 10: Revisões Documentais (organizations/{orgId}/document_revisions/{revisionId})
      // Imutabilidade: Revisões aprovadas / vigentes protegidas contra edição arbitrária
      // ----------------------------------------------------
      match /document_revisions/{revisionId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(revisionId);
        allow update: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(revisionId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(revisionId);
      }

      // ----------------------------------------------------
      // FASE 10: Fontes Externas (organizations/{orgId}/external_document_sources/{sourceId})
      // ----------------------------------------------------
      match /external_document_sources/{sourceId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update, delete: if userBelongsToOrg(organizationId) &&
                                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(sourceId);
      }

      // ----------------------------------------------------
      // FASE 10: Solicitações a Clientes (organizations/{orgId}/client_revision_requests/{requestId})
      // ----------------------------------------------------
      match /client_revision_requests/{requestId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) &&
                                 getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(requestId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(requestId);
      }

      // ----------------------------------------------------
      // FASE 10: Logs de Verificação Externa (organizations/{orgId}/external_verification_logs/{logId})
      // ----------------------------------------------------
      match /external_verification_logs/{logId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create: if userBelongsToOrg(organizationId) && isValidId(organizationId) && isValidId(logId);
        allow update: if userBelongsToOrg(organizationId) &&
                         (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(logId);
        allow delete: if userBelongsToOrg(organizationId) &&
                         isSystemAdmin() && isValidId(organizationId) && isValidId(logId);
      }

      // ----------------------------------------------------
      // FASE 10: Evidências de Consulta Documental (organizations/{orgId}/document_consult_evidences/{evidenceId})
      // ----------------------------------------------------
      match /document_consult_evidences/{evidenceId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create: if userBelongsToOrg(organizationId) && isValidId(organizationId) && isValidId(evidenceId);
        allow update, delete: if userBelongsToOrg(organizationId) &&
                                 isSystemAdmin() && isValidId(organizationId) && isValidId(evidenceId);
      }

      // ----------------------------------------------------
      // FASE 13: Clientes Externos (organizations/{orgId}/external_clients/{clientId})
      // ----------------------------------------------------
      match /external_clients/{clientId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) && (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(clientId);
        allow delete: if userBelongsToOrg(organizationId) && isSystemAdmin() && isValidId(organizationId) && isValidId(clientId);
      }

      // ----------------------------------------------------
      // FASE 13: Programas e Checklists de Clientes (organizations/{orgId}/client_programs/{programId})
      // ----------------------------------------------------
      match /client_programs/{programId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) && (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(programId);
        allow delete: if userBelongsToOrg(organizationId) && isSystemAdmin() && isValidId(organizationId) && isValidId(programId);
      }

      // ----------------------------------------------------
      // FASE 13: Controles Centrais SGQ (organizations/{orgId}/central_controls/{controlId})
      // ----------------------------------------------------
      match /central_controls/{controlId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) && (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(controlId);
        allow delete: if userBelongsToOrg(organizationId) && isSystemAdmin() && isValidId(organizationId) && isValidId(controlId);
      }

      // ----------------------------------------------------
      // FASE 13: Requisitos de Clientes (organizations/{orgId}/client_requirements/{requirementId})
      // ----------------------------------------------------
      match /client_requirements/{requirementId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) && (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(requirementId);
        allow delete: if userBelongsToOrg(organizationId) && isSystemAdmin() && isValidId(organizationId) && isValidId(requirementId);
      }

      // ----------------------------------------------------
      // FASE 13: Avaliações Periódicas (organizations/{orgId}/client_evaluations/{evaluationId})
      // ----------------------------------------------------
      match /client_evaluations/{evaluationId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) && getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(evaluationId);
        allow delete: if userBelongsToOrg(organizationId) && (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(evaluationId);
      }

      // ----------------------------------------------------
      // FASE 13: Bases e Estações Operacionais (organizations/{orgId}/operational_bases/{baseId})
      // ----------------------------------------------------
      match /operational_bases/{baseId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) && (isGestorSGQ() || isSystemAdmin()) && isValidId(organizationId) && isValidId(baseId);
        allow delete: if userBelongsToOrg(organizationId) && isSystemAdmin() && isValidId(organizationId) && isValidId(baseId);
      }

      // ----------------------------------------------------
      // FASE 14: Importações Inteligentes e Rastreabilidade (organizations/{orgId}/smart_imports/{importId})
      // ----------------------------------------------------
      match /smart_imports/{importId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) && getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(importId);
        allow delete: if userBelongsToOrg(organizationId) && (isGestorSGQ() || isSystemAdmin() || getUserRole() != 'CONSULTA') && isValidId(organizationId) && isValidId(importId);
      }

      // ----------------------------------------------------
      // FASE 14: Modelos de Mapeamento Aprovados (organizations/{orgId}/import_templates/{templateId})
      // ----------------------------------------------------
      match /import_templates/{templateId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) && getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(templateId);
        allow delete: if userBelongsToOrg(organizationId) && (isGestorSGQ() || isSystemAdmin() || getUserRole() != 'CONSULTA') && isValidId(organizationId) && isValidId(templateId);
      }

      // ----------------------------------------------------
      // FASE 14: Ferramentas e Instrumentos Calibrados Metrologia (organizations/{orgId}/calibrated_tools/{toolId})
      // ----------------------------------------------------
      match /calibrated_tools/{toolId} {
        allow get, list: if userBelongsToOrg(organizationId);
        allow create, update: if userBelongsToOrg(organizationId) && getUserRole() != 'CONSULTA' && isValidId(organizationId) && isValidId(toolId);
        allow delete: if userBelongsToOrg(organizationId) && (isGestorSGQ() || isSystemAdmin() || getUserRole() != 'CONSULTA') && isValidId(organizationId) && isValidId(toolId);
      }
    }

    // ----------------------------------------------------
    // System Diagnostics Collection (systemDiagnostics/{diagnosticId})
    // ----------------------------------------------------
    match /systemDiagnostics/{diagnosticId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(diagnosticId);
      allow delete: if isSystemAdmin() && isValidId(diagnosticId);
    }
  }
}
